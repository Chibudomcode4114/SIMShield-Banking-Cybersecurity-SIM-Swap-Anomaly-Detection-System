# ==============================================================================
# SIMShield Environment Configuration Example (Sanitized Template)
# ==============================================================================
# Safe placeholder configuration for local development.
# Copy this file to .env and adjust variables as necessary.
# DO NOT commit the .env file to source control.
# ==============================================================================

# Project Identity
PROJECT_NAME="SIMShield"
PROJECT_SLUG="simshield"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 1. Web Service (Nuxt 3 / TypeScript UI Shell)
# ------------------------------------------------------------------------------
PORT_WEB=3000
# Browser-facing address used by client-side web application
NUXT_PUBLIC_API_BASE=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. BFF / API Service (NestJS on Node.js)
# ------------------------------------------------------------------------------
PORT_API=3001
NODE_ENV=development
# Internal connection strings used by the NestJS BFF
DATABASE_URL="mysql://simshield_user:simshield_password@localhost:3307/simshield_db"
AI_SERVICE_URL="http://localhost:8000"
WEAVIATE_URL="http://localhost:8080"

# ------------------------------------------------------------------------------
# 3. AI Service (FastAPI on Python)
# ------------------------------------------------------------------------------
PORT_AI=8000
AI_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 4. Relational Database (MySQL 8.0)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=simshield_db
MYSQL_USER=simshield_user
MYSQL_PASSWORD=simshield_password
MYSQL_ROOT_PASSWORD=simshield_root_password

# ------------------------------------------------------------------------------
# 5. Vector Database (Weaviate)
# ------------------------------------------------------------------------------
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=true
PERSISTENCE_DATA_PATH=/var/lib/weaviate
QUERY_DEFAULTS_LIMIT=25
